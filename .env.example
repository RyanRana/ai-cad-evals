# Copy to .env.local and fill in. Site + bench both read from here.

# ---- Storage / DB (Vercel Marketplace; auto-injected on Vercel) -----------
POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=

# ---- Agent keys (each one unlocks one column on the leaderboard) -----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ZOO_API_KEY=
XAI_API_KEY=

# ---- Optional: route everything through the Vercel AI Gateway --------------
# When set, anthropic_cadquery / openai_cadquery / google_cadquery will use
# the gateway's "<provider>/<model>" routing instead of direct provider keys.
AI_GATEWAY_API_KEY=

# ---- Bench knobs -----------------------------------------------------------
BENCH_SEEDS=1
BENCH_TIMEOUT_S=180
