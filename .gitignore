# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capture / authoring artefacts
screenshots/
viral-prep/

# Local benchmark sweep outputs
runs/
.env*.local

# Bench artifacts: ignore reference + candidate STEP binaries, but commit the
# rolled-up JSON so Vercel deploys can render real sweep numbers.
bench/_artifacts/**
!bench/_artifacts/
!bench/_artifacts/runs.json
bench/.venv/
bench/__pycache__/
bench/**/__pycache__/
*.pyc
